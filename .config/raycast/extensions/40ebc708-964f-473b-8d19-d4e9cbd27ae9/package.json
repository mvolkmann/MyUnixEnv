{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "color-picker",
  "title": "Color Picker",
  "description": "Pick and organize colors, everywhere on your Mac",
  "icon": "icon.png",
  "author": "thomas",
  "contributors": [
    "otakustay",
    "EmersonEmerson",
    "pernielsentikaer",
    "arronhunt",
    "kvdo2",
    "litomore",
    "samuelkraft",
    "ridemountainpig",
    "xilopaint",
    "anwarulislam",
    "yusifaliyevpro",
    "elibattistoni",
    "clins1994",
    "just_me",
    "ray.dhruv"
  ],
  "pastContributors": [
    "thomaslombart"
  ],
  "categories": [
    "Design Tools"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "pick-color",
      "title": "Pick Color",
      "description": "Pick a color on your desktop",
      "mode": "no-view",
      "preferences": [
        {
          "name": "showColorName",
          "title": "Show color name after picking",
          "description": "Show the name of the picked color after picking",
          "type": "checkbox",
          "label": "Show",
          "default": false,
          "required": false
        }
      ]
    },
    {
      "name": "extract-color",
      "title": "Extract Color from Selected Image",
      "description": "Extract colors from the selected File Explorer image",
      "mode": "view"
    },
    {
      "name": "menu-bar",
      "title": "Menu Bar Color Picker",
      "description": "Access your colors from the menu bar",
      "mode": "menu-bar"
    },
    {
      "name": "organize-colors",
      "title": "Organize Colors",
      "description": "Organize your colors",
      "mode": "view",
      "preferences": [
        {
          "data": [
            {
              "title": "Paste to Active App",
              "value": "paste"
            },
            {
              "title": "Copy to Clipboard",
              "value": "copy"
            }
          ],
          "default": "copy",
          "description": "The primary action to perform on a selected color",
          "name": "primaryAction",
          "required": false,
          "title": "Primary Action",
          "type": "dropdown"
        }
      ]
    },
    {
      "name": "favorite-colors",
      "title": "Favorite Colors",
      "description": "View and use your favorite colors",
      "mode": "view"
    },
    {
      "name": "generate-colors",
      "title": "Generate Colors",
      "description": "Generate colors using AI",
      "mode": "view",
      "arguments": [
        {
          "name": "prompt",
          "placeholder": "Prompt",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "name": "color-names",
      "title": "Color Names",
      "description": "Get the name of a color",
      "mode": "view",
      "preferences": [
        {
          "type": "dropdown",
          "name": "colorNamesPerGroup",
          "required": false,
          "title": "Color Names Per Group",
          "description": "The number of color names to display per group",
          "data": [
            {
              "title": "5",
              "value": "5"
            },
            {
              "title": "10",
              "value": "10"
            },
            {
              "title": "25",
              "value": "25"
            },
            {
              "title": "All",
              "value": "Infinity"
            }
          ]
        }
      ]
    },
    {
      "name": "color-wheel",
      "title": "Color Wheel",
      "description": "Pick a color with color wheel",
      "mode": "view"
    },
    {
      "name": "convert-color",
      "title": "Convert Color",
      "description": "Convert any color to a different format",
      "mode": "view",
      "arguments": [
        {
          "name": "text",
          "type": "text",
          "required": false,
          "placeholder": "#FF6363"
        }
      ]
    }
  ],
  "preferences": [
    {
      "data": [
        {
          "title": "HEX - #FF6363",
          "value": "hex"
        },
        {
          "title": "HEX Lower Case - #ff6363",
          "value": "hex-lower-case"
        },
        {
          "title": "HEX No Prefix - FF6363",
          "value": "hex-no-prefix"
        },
        {
          "title": "RGB - rgb(255 99 99 / 100%)",
          "value": "rgb"
        },
        {
          "title": "RGB % - rgb(100% 38% 38% / 100%)",
          "value": "rgb-percentage"
        },
        {
          "title": "RGBA - rgba(255, 99, 99, 1)",
          "value": "rgba"
        },
        {
          "title": "RGBA % - rgba(100%, 39%, 39%, 1)",
          "value": "rgba-percentage"
        },
        {
          "title": "HSLA - hsla(0, 100%, 69%, 1)",
          "value": "hsla"
        },
        {
          "title": "HSVA - color(hsv 43.082 81.145 100)",
          "value": "hsva"
        },
        {
          "title": "OKLCH - oklch(0.6987 0.1902 23.468)",
          "value": "oklch"
        },
        {
          "title": "LCH - lch(63.127 68.676 28.723)",
          "value": "lch"
        },
        {
          "title": "P3 - color(display-p3 0.9248 0.428 0.4078)",
          "value": "p3"
        }
      ],
      "default": "hex",
      "description": "The color format to use when copying/pasting colors",
      "name": "colorFormat",
      "required": false,
      "title": "Color Format",
      "type": "dropdown"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.6",
    "@raycast/utils": "^2.2.2",
    "color-namer": "^1.4.0",
    "colorjs.io": "^0.5.1",
    "lodash": "^4.17.23",
    "raycast-cross-extension": "^0.2.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/color-namer": "^1.3.3",
    "@types/lodash": "^4.17.23",
    "@types/node": "^24.2.1",
    "@types/react": "^19.2.10",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "test": "node --test test/*.test.mjs",
    "pull": "ray pull-contributions",
    "publish": "ray publish"
  },
  "platforms": [
    "macOS",
    "Windows"
  ],
  "ai": {
    "instructions": "Use convert-color when the user wants a color converted to a specific format. Pass CSS color values exactly as supplied and use one of the tool's supported format values.\nUse name-color when the user asks what a color is called or wants the nearest named colors.\nUse list-saved-colors for questions about Color Picker history, recent colors, or favorites. Use filter \"favorites\" only when the user specifically asks for favorites.\nUse save-colors only when the user explicitly asks to save colors to history or favorites. Pass multiple CSS color values as one semicolon-separated string. Set favorite to true when the user asks to favorite or favourite colors; otherwise omit it. The tool asks for confirmation before changing Color Picker history. Invoke it directly and let the tool confirmation obtain approval; do not ask for an additional chat confirmation.\nUse analyze-contrast when the user asks about contrast, readability, or WCAG accessibility for a foreground and background color.\nUse generate-color-scale to create an 11-step 50-950 scale from one opaque base color. The scale uses OKLCH interpolation and keeps the base color at 500.\nUse format-palette when the user wants colors formatted as JSON, CSS variables, or CSS classes. Pass multiple colors as one semicolon-separated string and set format to json, css-variables, or css-classes.\nRaycast AI can devise a palette from a natural-language description. Call save-colors after generating it only when the user also asks to save it.\nNever claim that a color was picked from the screen or extracted from an image because these tools cannot inspect the screen or selected files.\n",
    "evals": [
      {
        "input": "@color-picker Convert #FF6363 to OKLCH.",
        "mocks": {
          "convert-color": {
            "input": "#FF6363",
            "format": "oklch",
            "color": "oklch(69.87% 0.1902 23.468)"
          }
        },
        "expected": [
          {
            "callsTool": {
              "name": "convert-color",
              "arguments": {
                "color": "#FF6363",
                "format": "oklch"
              }
            }
          }
        ]
      },
      {
        "input": "@color-picker What is the closest name for #663399?",
        "mocks": {
          "name-color": {
            "color": "#663399",
            "names": [
              {
                "name": "Rebecca Purple",
                "hex": "#663399",
                "distance": 0
              }
            ]
          }
        },
        "expected": [
          {
            "callsTool": {
              "name": "name-color",
              "arguments": {
                "color": "#663399"
              }
            }
          }
        ]
      },
      {
        "input": "@color-picker Show my 5 most recent favorite colors.",
        "mocks": {
          "list-saved-colors": {
            "filter": "favorites",
            "totalCount": 1,
            "colors": [
              {
                "color": "#663399",
                "title": "Brand purple",
                "isFavorite": true,
                "savedAt": "2026-08-26T09:00:00.000Z"
              }
            ]
          }
        },
        "expected": [
          {
            "callsTool": {
              "name": "list-saved-colors",
              "arguments": {
                "filter": "favorites",
                "limit": 5
              }
            }
          }
        ]
      },
      {
        "input": "@color-picker Save #FF6363 and #66D3BB to my color history.",
        "mocks": {
          "save-colors": {
            "savedCount": 2,
            "colors": [
              "#FF6363",
              "#66D3BB"
            ],
            "favorite": false,
            "message": "Added 2 colors to Color Picker history."
          }
        },
        "expected": [
          {
            "callsTool": {
              "name": "save-colors",
              "arguments": {
                "colors": {
                  "matches": "^#FF6363;\\s*#66D3BB$"
                }
              }
            }
          }
        ]
      },
      {
        "input": "@color-picker Add #E6E6E7 to my favourites.",
        "mocks": {
          "save-colors": {
            "savedCount": 1,
            "colors": [
              "#E6E6E7"
            ],
            "favorite": true,
            "message": "Added 1 color to Color Picker favorites."
          }
        },
        "expected": [
          {
            "callsTool": {
              "name": "save-colors",
              "arguments": {
                "colors": "#E6E6E7",
                "favorite": true
              }
            }
          }
        ]
      },
      {
        "input": "@color-picker Does #777777 text on #FFFFFF pass WCAG AA contrast?",
        "mocks": {
          "analyze-contrast": {
            "foreground": "#777777",
            "background": "#FFFFFF",
            "ratio": 4.48,
            "passes": {
              "aaNormalText": false,
              "aaLargeText": true,
              "aaaNormalText": false,
              "aaaLargeText": false,
              "nonText": true
            }
          }
        },
        "expected": [
          {
            "callsTool": {
              "name": "analyze-contrast",
              "arguments": {
                "foreground": "#777777",
                "background": "#FFFFFF"
              }
            }
          }
        ]
      },
      {
        "input": "@color-picker Generate a 50-950 color scale from #FF6363.",
        "mocks": {
          "generate-color-scale": {
            "baseColor": "#FF6363",
            "colorSpace": "oklch",
            "scale": [
              {
                "label": 50,
                "color": "#FFFFFF"
              },
              {
                "label": 500,
                "color": "#FF6363"
              },
              {
                "label": 950,
                "color": "#000000"
              }
            ]
          }
        },
        "expected": [
          {
            "callsTool": {
              "name": "generate-color-scale",
              "arguments": {
                "color": "#FF6363"
              }
            }
          }
        ]
      },
      {
        "input": "@color-picker Format #FF6363 and #66D3BB as CSS variables.",
        "mocks": {
          "format-palette": ":root {\n  --color-1: #FF6363;\n  --color-2: #66D3BB;\n}"
        },
        "expected": [
          {
            "callsTool": {
              "name": "format-palette",
              "arguments": {
                "colors": {
                  "matches": "^#FF6363;\\s*#66D3BB$"
                },
                "format": "css-variables"
              }
            }
          }
        ]
      }
    ]
  }
}